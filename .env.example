# Copia este archivo a .env y ajusta los valores.

# Clave para firmar los JWT. Si se omite, se genera una y se guarda en data/.secret_key
SECRET_KEY=
# Duración de la sesión (minutos)
TOKEN_EXPIRE_MINUTES=480
# Poner en 1 cuando se sirva por HTTPS (cookie con flag Secure)
COOKIE_SECURE=0

# Base de datos (SQLite local por defecto)
DATABASE_URL=sqlite:///./data/farmacia.db

# Alerta de caducidad (días)
DIAS_ALERTA_CADUCIDAD=90

# Telegram
TELEGRAM_BOT_TOKEN=
# polling = el servidor consulta a Telegram (ideal en local). webhook = Telegram llama a /api/telegram/webhook
TELEGRAM_MODE=polling
# Solo para modo webhook: se envía como secret_token en setWebhook
TELEGRAM_WEBHOOK_SECRET=
# Lista de chat_id autorizados separados por coma. Vacío = cualquiera que conozca el bot
TELEGRAM_ALLOWED_CHAT_IDS=

# Ollama
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=180
